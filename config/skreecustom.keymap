#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        new-default {
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3                &kp N4            &kp N5          &kp N6    &kp N7    &kp N8         &kp N9      &kp N0            &kp MINUS            &kp PRINTSCREEN  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_SEARCH    &kp LG(NUMBER_3)  &kp TAB       &kp EQUAL      &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E                 &kp R             &kp T           &kp Y     &kp U     &kp I          &kp O       &kp P             &kp SQT              &kp K_MUTE       &kp C_VOLUME_DOWN                  &kp C_VOLUME_UP    &kp DOLLAR        &kp KP_COMMA  &kp KP_DIVIDE  &kp KP_MULTIPLY
&kp LSHFT  &kp A   &kp S   &kp D                 &kp F             &kp G           &kp H     &kp J     &kp K          &kp L       &kp SLASH         &kp SEMICOLON        &kp LG(B)        &kp LG(I)                          &kp LG(U)          &kp N7            &kp N8        &kp N9         &kp KP_SUBTRACT
&mkp MB2   &kp Z   &kp X   &kp C                 &kp V             &kp B           &kp N     &kp M     &kp COMMA      &kp PERIOD  &kp LEFT_BRACKET  &kp RIGHT_BRACKET                                                                           &kp N4            &kp N5        &kp N6         &kp KP_PLUS
                                                                                                                                                                                          &kp UP                                                &kp N1            &kp N2        &kp N3         &kp RET
                                                                                                                                                                         &kp LEFT         &kp DOWN                           &kp RIGHT          &kp N0                          &kp DOT
                           &mt LEFT_SHIFT SPACE  &kp LEFT_COMMAND  &kp LEFT_ALT                        &kp BACKSPACE
                           &kp K_CUT             &kp K_COPY        &kp K_PASTE     &mkp MB1  &kp RALT  &kp ENTER
            >;

            label = "new default";
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans
                                                                                                            &trans            &trans  &trans  &trans  &trans
                                                                                                    &trans  &trans  &trans    &trans          &trans
                        &trans  &trans  &trans                    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans
                                                                                                            &trans            &trans  &trans  &trans  &trans
                                                                                                    &trans  &trans  &trans    &trans          &trans
                        &trans  &trans  &trans                    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans
                                                                                                            &trans            &trans  &trans  &trans  &trans
                                                                                                    &trans  &trans  &trans    &trans          &trans
                        &trans  &trans  &trans                    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
